APP_ENV=production
APP_DEBUG=false
APP_URL=https://hgt.example.com
CORS_ALLOWED_ORIGINS=https://hgt.example.com,https://admin.hgt.example.com
API_RATE_LIMIT_ENABLED=true

DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=turtle_soup
DB_USER=turtle_soup
DB_PASSWORD=replace-with-a-random-database-password
DB_PREFIX=
DB_CHARSET=utf8mb4
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

CACHE_MODE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_QUEUE_PREFIX=turtle_soup_queue:
REDIS_QUEUE_ENABLED=true
REDIS_QUEUE_CONSUMER_COUNT=1

CAPTCHA_MODE=cache
FRONTEND_DIR=system-manage-ui

COZE_API_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=
COZE_QUESTION_JUDGE_WORKFLOW_ID=
COZE_GUESS_JUDGE_WORKFLOW_ID=
COZE_GAME_DRIVER=coze
COZE_WORKFLOW_ID=
COZE_DRIVER=coze
COZE_TIMEOUT_SECONDS=120
COZE_RETRY_TIMES=1
COZE_RETRY_DELAY_MS=250

ANONYMOUS_TOKEN_TTL_DAYS=30
ANONYMOUS_TOKEN_SECRET=replace-with-an-independent-random-secret
PLAYER_JWT_SECRET=replace-with-an-independent-random-secret
PLAYER_TOKEN_HASH_SECRET=replace-with-an-independent-random-secret
PLAYER_EMAIL_CODE_SECRET=replace-with-an-independent-random-secret
PLAYER_ACCESS_TOKEN_TTL=900
PLAYER_REFRESH_TOKEN_TTL=2592000
PLAYER_MAX_SESSIONS=3

GAME_WS_LISTEN=websocket://0.0.0.0:8790
ROOM_IDLE_TIMEOUT_SECONDS=1800
ROOM_CLEANUP_INTERVAL_SECONDS=60

MAIL_ENABLED=false
MAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=海龟汤
MAIL_FROM_NAME=海龟汤

BOS_ACCESS_KEY=
BOS_SECRET_KEY=
BOS_ENDPOINT=https://bj.bcebos.com
BOS_BUCKET=
BOS_PUBLIC_BASE_URL=

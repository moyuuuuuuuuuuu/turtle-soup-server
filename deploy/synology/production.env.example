APP_ENV=production
APP_DEBUG=false
# Synology account owning data/server-runtime and data/uploads (id -u / id -g).
SERVER_UID=1026
SERVER_GID=100
APP_URL=https://hgt.example.com
CORS_ALLOWED_ORIGINS=https://hgt.example.com,https://admin.hgt.example.com
API_RATE_LIMIT_ENABLED=true
# Set the exact gateway/NAS proxy addresses or dedicated proxy-only CIDRs.
# Empty is safe but combines clients behind the proxy into one IP quota.
TRUSTED_PROXY_CIDRS=
GAME_GUEST_CALLS_PER_MINUTE=10
GAME_GUEST_CALLS_PER_DAY=120
GAME_USER_CALLS_PER_MINUTE=20
GAME_USER_CALLS_PER_DAY=300
GAME_IP_CALLS_PER_MINUTE=60
GAME_IP_CALLS_PER_DAY=1000
GAME_GLOBAL_CALLS_PER_DAY=10000
GAME_IP_CONCURRENCY=4
GAME_GLOBAL_CONCURRENCY=20

DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=turtle_soup
DB_USER=turtle_soup
DB_PASSWORD=replace-with-a-random-database-password
DB_PREFIX=
DB_CHARSET=utf8mb4
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

CACHE_MODE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_QUEUE_PREFIX=turtle_soup_queue:
REDIS_QUEUE_ENABLED=true
REDIS_QUEUE_CONSUMER_COUNT=1

CAPTCHA_MODE=cache
FRONTEND_DIR=system-manage-ui

COZE_API_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=
COZE_QUESTION_JUDGE_WORKFLOW_ID=
COZE_GUESS_JUDGE_WORKFLOW_ID=
COZE_GAME_DRIVER=coze
COZE_WORKFLOW_ID=
COZE_DRIVER=coze
COZE_TIMEOUT_SECONDS=120
COZE_RETRY_TIMES=1
COZE_RETRY_DELAY_MS=250

ANONYMOUS_TOKEN_TTL_DAYS=30
ANONYMOUS_TOKEN_SECRET=replace-with-an-independent-random-secret
PLAYER_JWT_SECRET=replace-with-an-independent-random-secret
PLAYER_TOKEN_HASH_SECRET=replace-with-an-independent-random-secret
PLAYER_EMAIL_CODE_SECRET=replace-with-an-independent-random-secret
PLAYER_ACCESS_TOKEN_TTL=900
PLAYER_REFRESH_TOKEN_TTL=2592000
PLAYER_MAX_SESSIONS=3

# Fill only the login providers enabled for this release.
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
DOUYIN_MINI_PROGRAM_APP_ID=
DOUYIN_MINI_PROGRAM_APP_SECRET=
MINI_PROGRAM_LOGIN_TIMEOUT_SECONDS=10
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
WECHAT_OFFICIAL_ACCOUNT_REDIRECT_URI=
WECHAT_OFFICIAL_ACCOUNT_OAUTH_SCOPE=snsapi_userinfo
WECHAT_OPEN_PLATFORM_APP_ID=
WECHAT_OPEN_PLATFORM_APP_SECRET=
WECHAT_OPEN_PLATFORM_REDIRECT_URI=
DOUYIN_OPEN_PLATFORM_APP_ID=
DOUYIN_OPEN_PLATFORM_APP_SECRET=
DOUYIN_OPEN_PLATFORM_REDIRECT_URI=
THIRD_PARTY_AUTH_TIMEOUT_SECONDS=10

GAME_WS_LISTEN=websocket://0.0.0.0:8790
ROOM_IDLE_TIMEOUT_SECONDS=1800
ROOM_CLEANUP_INTERVAL_SECONDS=60

MAIL_ENABLED=false
MAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=海龟汤
MAIL_FROM_NAME=海龟汤

BOS_ACCESS_KEY=
BOS_SECRET_KEY=
BOS_ENDPOINT=https://bj.bcebos.com
BOS_BUCKET=
